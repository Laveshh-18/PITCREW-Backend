APP_ENV=development
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=complaint-photos
ADMIN_API_KEY=
SENSOR_API_KEY=
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_REGEX=
RATE_LIMIT_WRITES_PER_MIN=60
RATE_LIMIT_PHOTO_PER_MIN=10
RATE_LIMIT_AUTH_FAIL_PER_MIN=10
LOG_LEVEL=INFO
# PORT is injected by Render. Do not set it there.
# FIXTURES_DIR=   (optional, defaults to backend/fixtures)
